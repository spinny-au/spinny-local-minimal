SPINNY_HOME=
SPINNY_CONTROL_URL=https://spinny.au
SPINNY_RELAY_URL=wss://relay.spinny.au/node
SPINNY_OLLAMA_URL=http://127.0.0.1:11434
SPINNY_CONTROL_PLANE_PUBLIC_KEY=

# Development only. Allows vault key material to be wrapped in a local file if
# the OS keychain command is unavailable.
SPINNY_ALLOW_INSECURE_FILE_KEY=0

# Development only. Allows unsigned relay tasks. Must stay 0 in production.
SPINNY_ALLOW_UNSIGNED_TASKS=0
